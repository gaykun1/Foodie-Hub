{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "foodiehub-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "client"],
      "port": 3000,
      "autoPort": true,
      "env": {
        "NEXT_PUBLIC_DEMO_MODE": "true"
      }
    },
    {
      "name": "foodiehub-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "server"],
      "port": 5000,
      "env": {
        "DEMO_SIMULATION": "true"
      }
    }
  ]
}
