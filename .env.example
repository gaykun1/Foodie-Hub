# ---------------------------------------------------------------------------
# Server environment (copy to server/.env)
# ---------------------------------------------------------------------------

# MongoDB connection string. A local instance or a free Atlas cluster both work.
MONGO_URI=mongodb://127.0.0.1:27017/foodiehub

# Secret used to sign auth JWTs. Use a long random value in production.
JWT_SECRET=

PORT=5000

# Origin allowed to make credentialed requests (the Next.js app).
CORS_ORIGIN=http://localhost:3000

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Transactional email. Leave blank to disable order emails entirely — the
# server boots and works fine without it.
RESEND_API_KEY=
ORDER_EMAIL_FROM=FoodieHub <orders@example.com>

# Set to "true" to expose the demo delivery simulator, which walks a placed
# order through Preparing -> Delivering -> Delivered and animates the courier
# along the route. Intended for the public demo deployment only; every /api/demo
# route 404s while this is unset.
DEMO_SIMULATION=false


# ---------------------------------------------------------------------------
# Client environment (copy to client/.env.local)
# ---------------------------------------------------------------------------

# Base URL of the API above.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Stripe publishable (test) key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Set to "true" to show the demo affordances: one-click demo sign-in on the
# login screen and the Stripe test card on checkout. Leave unset for a real
# deployment so shared credentials are never advertised.
NEXT_PUBLIC_DEMO_MODE=false
